#!/usr/bin/env bash
# Pre-commit safety net: blocks a commit if node_modules exists locally
# (meaning npm install has been run) but package-lock.json is not staged.
# This is what causes the GitHub Actions "Dependencies lock file is not
# found" failure on first push — this hook exists so that failure can never
# happen again, regardless of who or what is doing the committing.

set -e

if [ -d "node_modules" ] && [ -f "package.json" ]; then
  if [ ! -f "package-lock.json" ]; then
    echo "❌ commit blocked: node_modules exists but package-lock.json is missing."
    echo "   Run: npm install    (this generates package-lock.json)"
    echo "   Then: git add package-lock.json"
    exit 1
  fi

  if ! git diff --cached --name-only | grep -q "^package-lock.json$" \
     && ! git ls-files --error-unmatch package-lock.json > /dev/null 2>&1; then
    echo "❌ commit blocked: package-lock.json exists on disk but isn't tracked by git."
    echo "   Run: git add package-lock.json"
    exit 1
  fi
fi

exit 0
